"s-17": {
"f": "audio/s-17.mp3",
"fi": "Sukka... ruotsiksi? Strumppa? Strumpa...? Strumpa! Sukka... strumpa. Siili har... en strumpa.",
"sv": ""
},
"m-01": {
"f": "audio/m-01.mp3",
"fi": "Jag... är... hungrig? Minulla on nälkä. Jag är hungrig!",
"sv": ""
},
"m-02": {
"f": "audio/m-02.mp3",
"fi": "Var... är... bullen? Missä on pulla? Var är bullen?",
"sv": ""
},
"m-03": {
"f": "audio/m-03.mp3",
"fi": "Blomman... luktar... gott. Kukka tuoksuu hyvältä. Blomman luktar gott!",
"sv": ""
},
"m-04": {
"f": "audio/m-04.mp3",
"fi": "Jag... hittar... inte. En löydä. Jag hittar inte!",
"sv": ""
},
"m-05": {
"f": "audio/m-05.mp3",
"fi": "Det... är... här! Se on täällä! Det är här!",
"sv": ""
},
"m-06": {
"f": "audio/m-06.mp3",
"fi": "Du... är... min kompis. Sinä olet minun kaverini. Du är min kompis!",
"sv": ""
},
"m-07": {
"f": "audio/m-07.mp3",
"fi": "Jag... pratar... lite svenska. Minä puhun vähän ruotsia. Jag pratar lite svenska!",
"sv": ""
},
"a-01": {
"f": "audio/a-01.mp3",
"fi": "Oikein! Rätt!",
"sv": ""
},
"a-02": {
"f": "audio/a-02.mp3",
"fi": "Jee! Bra!",
"sv": ""
},
"a-03": {
"f": "audio/a-03.mp3",
"fi": "Sinä osaat! Du kan!",
"sv": ""
},
"a-04": {
"f": "audio/a-04.mp3",
"fi": "Melkein! Nästan! Yritä vielä.",
"sv": ""
},
"a-05": {
"f": "audio/a-05.mp3",
"fi": "Hups! Ei se mitään. Det gör inget!",
"sv": ""
},
"a-06": {
"f": "audio/a-06.mp3",
"fi": "Höh. Minäkin teen virheitä. Jag med!",
"sv": ""
},
"e-01": {
"f": "audio/e-01.mp3",
"fi": "Kiitos, Saga! Tack! Sinä olet hyvä opettaja. Bra lärare!",
"sv": "Du är en bra lärare!"
},
"e-02": {
"f": "audio/e-02.mp3",
"fi": "Nähdään huomenna! Vi ses... i morgon? Heippa!",
"sv": "Vi ses i morgon!"
},
"e-03": {
"f": "audio/e-03.mp3",
"fi": "Minä menen nukkumaan. Hyvää yötä! ... God natt!",
"sv": "Jag går och lägger mig."
},
"rec1-01": {
"f": "audio/rec1-01.mp3",
"fi": "Hmm... mitä? Onko jo aamu?",
"sv": "Hm ... va? Är det redan morgon?"
},
"rec1-02": {
"f": "audio/rec1-02.mp3",
"fi": "Huomenta! Hyvää huomenta!",
"sv": "God morgon!"
},
"rec1-03": {
"f": "audio/rec1-03.mp3",
"fi": "Moi! Minä olen Siili. Minä asun tässä, portaiden alla.",
"sv": "Hej! Jag är Siili. Jag bor här, under trappan."
},
"rec1-04": {
"f": "audio/rec1-04.mp3",
"fi": "Oho! Sinä näet minut! Kukaan ei yleensä näe minua.",
"sv": "Oj! Du ser mig! Ingen brukar se mig."
},
"rec1-05": {
"f": "audio/rec1-05.mp3",
"fi": "Minä puhun suomea. Ja vähän ruotsia. Hyvin, hyvin vähän.",
"sv": "Jag pratar finska. Och lite svenska. Väldigt lite."
},
"rec1-06": {
"f": "audio/rec1-06.mp3",
"fi": "Tiedätkö mitä? Suomen kielessä on paljon hauskoja sanoja. Kuuntele!",
"sv": "Vet du vad? Finskan har massor av roliga ord. Lyssna!"
},
"rec1-07": {
"f": "audio/rec1-07.mp3",
"fi": "Moi!",
"sv": "hej"
},
"rec1-08": {
"f": "audio/rec1-08.mp3",
"fi": "Hau!",
"sv": "vov"
},
"rec1-09": {
"f": "audio/rec1-09.mp3",
"fi": "Iik!",
"sv": "iii"
},
"rec1-10": {
"f": "audio/rec1-10.mp3",
"fi": "Vau!",
"sv": "wow"
},
"rec1-11": {
"f": "audio/rec1-11.mp3",
"fi": "Kääk!",
"sv": "aaa!"
},
"rec1-12": {
"f": "audio/rec1-12.mp3",
"fi": "Hys!",
"sv": "sch"
},
"rec1-13": {
"f": "audio/rec1-13.mp3",
"fi": "Yök!",
"sv": "usch"
},
"rec1-14": {
"f": "audio/rec1-14.mp3",
"fi": "Oho!",
"sv": "oj"
},
"rec1-15": {
"f": "audio/rec1-15.mp3",
"fi": "Hyi!",
"sv": "fy"
},
"rec1-16": {
"f": "audio/rec1-16.mp3",
"fi": "Höh.",
"sv": "äh"
},
"rec1-17": {
"f": "audio/rec1-17.mp3",
"fi": "Viuh!",
"sv": "svisch"
},
"rec1-18": {
"f": "audio/rec1-18.mp3",
"fi": "Jee!",
"sv": "jippi"
},
"rec1-19": {
"f": "audio/rec1-19.mp3",
"fi": "Nyyh.",
"sv": "snyft"
},
"rec1-20": {
"f": "audio/rec1-20.mp3",
"fi": "Niisk.",
"sv": "snörvel"
},
"rec1-21": {
"f": "audio/rec1-21.mp3",
"fi": "Lääh.",
"sv": "puh"
},
"rec1-22": {
"f": "audio/rec1-22.mp3",
"fi": "Pum!",
"sv": "pang"
},
"rec1-23": {
"f": "audio/rec1-23.mp3",
"fi": "Jee! Minä löysin pullan!",
"sv": "Jippi! Jag hittade en bulle!"
},
"rec1-24": {
"f": "audio/rec1-24.mp3",
"fi": "Nyyh... pulla on loppu.",
"sv": "Snyft ... bullen är slut."
},
"rec1-25": {
"f": "audio/rec1-25.mp3",
"fi": "Yök! Tämä pulla on vanha.",
"sv": "Usch! Den här bullen är gammal."
},
"rec1-26": {
"f": "audio/rec1-26.mp3",
"fi": "Hys! Joku tulee portaissa.",
"sv": "Sch! Någon kommer i trappan."
},
"rec1-27": {
"f": "audio/rec1-27.mp3",
"fi": "Lääh, lääh... portaita on niin monta.",
"sv": "Puh, puh ... det är så många trappsteg."
},
"rec1-28": {
"f": "audio/rec1-28.mp3",
"fi": "Pum! Pallo osui oveen.",
"sv": "Pang! Bollen träffade dörren."
},
"rec1-29": {
"f": "audio/rec1-29.mp3",
"fi": "Viuh! Tuuli on kova tänään.",
"sv": "Svisch! Det blåser hårt i dag."
},
"rec1-30": {
"f": "audio/rec1-30.mp3",
"fi": "Kääk! Missä minun kaulaliinani on?",
"sv": "Aaa! Var är min halsduk?"
},
"rec1-31": {
"f": "audio/rec1-31.mp3",
"fi": "Höh. Sataa taas.",
"sv": "Äh. Det regnar igen."
},
"rec1-32": {
"f": "audio/rec1-32.mp3",
"fi": "Niisk. Minulla on nuha.",
"sv": "Snörvel. Jag är snuvig."
},
"rec1-33": {
"f": "audio/rec1-33.mp3",
"fi": "Vau! Kuinka kaunis lumi!",
"sv": "Wow! Vilken fin snö!"
},
"rec1-34": {
"f": "audio/rec1-34.mp3",
"fi": "Hau hau! Ai, se oli vain koira.",
"sv": "Vov vov! Jaså, det var bara en hund."
},
"rec1-35": {
"f": "audio/rec1-35.mp3",
"fi": "Oho! Minä kaaduin.",
"sv": "Hoppsan! Jag ramlade."
},
"rec1-36": {
"f": "audio/rec1-36.mp3",
"fi": "Iik! Hämähäkki!",
"sv": "Iii! En spindel!"
},
"rec1-37": {
"f": "audio/rec1-37.mp3",
"fi": "Moi moi! Kiva nähdä sinut taas!",
"sv": "Hej hej! Kul att se dig igen!"
},
"rec1-38": {
"f": "audio/rec1-38.mp3",
"fi": "Mitä minä sanoin?",
"sv": "Vad sa jag?"
},
"rec1-39": {
"f": "audio/rec1-39.mp3",
"fi": "Kuuntele ja valitse.",
"sv": "Lyssna och välj."
},
"rec1-40": {
"f": "audio/rec1-40.mp3",
"fi": "Valitse oikea kuva.",
"sv": "Välj rätt bild."
},
"rec1-41": {
"f": "audio/rec1-41.mp3",
"fi": "Sano se ääneen!",
"sv": "Säg det högt!"
},
"rec1-42": {
"f": "audio/rec1-42.mp3",
"fi": "Sinun vuorosi!",
"sv": "Din tur!"
},
"rec1-43": {
"f": "audio/rec1-43.mp3",
"fi": "Oikein!",
"sv": "Rätt!"
},
"rec1-44": {
"f": "audio/rec1-44.mp3",
"fi": "Jee, oikein!",
"sv": "Jippi, rätt!"
},
"rec1-45": {
"f": "audio/rec1-45.mp3",
"fi": "Hienoa!",
"sv": "Fint!"
},
"rec1-46": {
"f": "audio/rec1-46.mp3",
"fi": "Tosi hyvä!",
"sv": "Jättebra!"
},
"rec1-47": {
"f": "audio/rec1-47.mp3",
"fi": "Sinä osaat!",
"sv": "Du kan!"
},
"rec1-48": {
"f": "audio/rec1-48.mp3",
"fi": "Vau, sinä olet nopea!",
"sv": "Wow, du är snabb!"
},
"rec1-49": {
"f": "audio/rec1-49.mp3",
"fi": "Juuri niin!",
"sv": "Just det!"
},
"rec1-50": {
"f": "audio/rec1-50.mp3",
"fi": "Mahtavaa!",
"sv": "Toppen!"
},
"rec1-51": {
"f": "audio/rec1-51.mp3",
"fi": "Ei ihan. Kuuntele uudestaan.",
"sv": "Inte riktigt. Lyssna igen."
},
"rec1-52": {
"f": "audio/rec1-52.mp3",
"fi": "Melkein! Yritä vielä.",
"sv": "Nästan! Försök igen."
},
"rec1-53": {
"f": "audio/rec1-53.mp3",
"fi": "Hups! Ei se mitään.",
"sv": "Hoppsan! Det gör inget."
},
"rec1-54": {
"f": "audio/rec1-54.mp3",
"fi": "Höh. Minäkin erehdyn joskus.",
"sv": "Äh. Jag gör också fel ibland."
},
"rec1-55": {
"f": "audio/rec1-55.mp3",
"fi": "Ei, ei... mutta hyvä yritys!",
"sv": "Nej ... men bra försök!"
},
"rec1-56": {
"f": "audio/rec1-56.mp3",
"fi": "Nyt tulee vaikea. Kuuntele tarkasti.",
"sv": "Nu kommer en svår. Lyssna noga."
},
"rec1-57": {
"f": "audio/rec1-57.mp3",
"fi": "Sanonko tuli vai tuuli?",
"sv": "Säger jag tuli eller tuuli?"
},
"rec1-58": {
"f": "audio/rec1-58.mp3",
"fi": "Tuli. Tuli on kuuma.",
"sv": "Eld. Elden är het."
},
"rec1-59": {
"f": "audio/rec1-59.mp3",
"fi": "Tuuli. Tuuli puhaltaa.",
"sv": "Vind. Vinden blåser."
},
"rec1-60": {
"f": "audio/rec1-60.mp3",
"fi": "Mato. Pieni mato.",
"sv": "Mask. En liten mask."
},
"rec1-61": {
"f": "audio/rec1-61.mp3",
"fi": "Matto. Iso matto.",
"sv": "Matta. En stor matta."
},
"rec1-62": {
"f": "audio/rec1-62.mp3",
"fi": "Kuka? Kuka sinä olet?",
"sv": "Vem? Vem är du?"
},
"rec1-63": {
"f": "audio/rec1-63.mp3",
"fi": "Kukka. Kaunis kukka.",
"sv": "Blomma. En fin blomma."
},
"rec1-64": {
"f": "audio/rec1-64.mp3",
"fi": "Hyi! Matolla on matto!",
"sv": "Fy! Det ligger en matta på mattan!"
},
"rec1-65": {
"f": "audio/rec1-65.mp3",
"fi": "Ai niin! Matolla on mato. Kiitos!",
"sv": "Just det! Det är en mask på mattan. Tack!"
},
"rec1-66": {
"f": "audio/rec1-66.mp3",
"fi": "Tuli tulee! Ei... tuuli tulee.",
"sv": "Elden kommer! Nej ... vinden kommer."
},
"rec1-67": {
"f": "audio/rec1-67.mp3",
"fi": "Pitkä ääni ja lyhyt ääni. Ne ovat eri sanoja!",
"sv": "Långt ljud och kort ljud. Det är olika ord!"
},
"rec1-68": {
"f": "audio/rec1-68.mp3",
"fi": "Kiitos! Sinä olet hyvä opettaja.",
"sv": "Tack! Du är en bra lärare."
},
"rec1-69": {
"f": "audio/rec1-69.mp3",
"fi": "Nähdään huomenna! Heippa!",
"sv": "Vi ses i morgon! Hejdå!"
},
"rec1-70": {
"f": "audio/rec1-70.mp3",
"fi": "Minä menen nukkumaan. Hyvää yötä!",
"sv": "Jag går och lägger mig. God natt!"
},
"rec1-71": {
"f": "audio/rec1-71.mp3",
"fi": "Missähän minun pullani on...",
"sv": "Undrar var min bulle är ..."
},
"rec1-72": {
"f": "audio/rec1-72.mp3",
"fi": "Hmm, hmm, hmm...",
"sv": ""
}
}