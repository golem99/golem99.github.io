{
"r1-01": {
"f": "audio/r1-01.mp3",
"fi": "Kuka siellä on? ... Kuka?",
"sv": "Vem är där?"
},
"r1-02": {
"f": "audio/r1-02.mp3",
"fi": "Oho! Ihminen! ... Hei...",
"sv": "Oj! En människa! Hej ..."
},
"r1-03": {
"f": "audio/r1-03.mp3",
"fi": "Moi, Saga! Minä olen här! Portaiden alla... under trappan!",
"sv": "Hej, Saga! Jag är här, under trappan!"
},
"r1-04": {
"f": "audio/r1-04.mp3",
"fi": "Minä olen Siili. Siili! ... Igelkott!",
"sv": ""
},
"r1-05": {
"f": "audio/r1-05.mp3",
"fi": "Tervetuloa! Välkommen! Minun kotini. Pieni koti. Liten!",
"sv": "Välkommen! Mitt hem. Litet hem."
},
"r1-06": {
"f": "audio/r1-06.mp3",
"fi": "Tämä on minun huoneeni. Bra huone! Mysig!",
"sv": "Det här är mitt rum."
},
"r1-07": {
"f": "audio/r1-07.mp3",
"fi": "Minulla on paljon tavaraa. Massa saker! Mutta en löydä!",
"sv": "Jag har massor av saker, men jag hittar inte!"
},
"r1-08": {
"f": "audio/r1-08.mp3",
"fi": "Auta minua, Saga! Snälla!",
"sv": "Hjälp mig, Saga!"
},
"r1-09": {
"f": "audio/r1-09.mp3",
"fi": "En ymmärrä... Säg igen? Hitaasti... långsamt?",
"sv": "Jag förstår inte. Säg igen? Långsamt?"
},
"r1-10": {
"f": "audio/r1-10.mp3",
"fi": "Minä olen pieni. Liten! Mutta rohkea. Modig! ... Lite modig.",
"sv": "Jag är liten. Men modig. Lite modig."
},
"r1-11": {
"f": "audio/r1-11.mp3",
"fi": "Minun kaulaliinani on sininen ja valkoinen. Blå och vit! Kuin Suomen lippu!",
"sv": "Min halsduk är blå och vit, som Finlands flagga!"
},
"r1-12": {
"f": "audio/r1-12.mp3",
"fi": "Juni asuu ylhäällä. Högst upp! Hän laskee portaita. Hän ei tiedä minusta!",
"sv": "Juni bor högst upp. Hon räknar trappsteg. Hon vet inte om mig!"
},
"r1-13": {
"f": "audio/r1-13.mp3",
"fi": "Aila on kiltti. Snäll! Hän antaa minulle pullaa. Bulle!",
"sv": "Aila är snäll. Hon ger mig bulle."
},
"r1-14": {
"f": "audio/r1-14.mp3",
"fi": "Kommissarien! Kyyhky... duvan! Minun naapurini. Granne! Hän sanoo vain... kurr kurr.",
"sv": "Kommissarien, duvan, är min granne."
},
"r1-15": {
"f": "audio/r1-15.mp3",
"fi": "Ruotsi on vaikea! Svårt! Niin monta å ja ö!",
"sv": "Svenska är svårt!"
},
"r1-16": {
"f": "audio/r1-16.mp3",
"fi": "Miksi teillä on Å? Teillä on jo O!",
"sv": "Varför har ni Å? Ni har redan O!"
},
"r1-17": {
"f": "audio/r1-17.mp3",
"fi": "Ollaanko kavereita? Kompisar? Ja?",
"sv": "Ska vi vara kompisar?"
},
